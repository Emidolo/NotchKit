<Project Sdk="Microsoft.NET.Sdk">
  <!-- NotchKit-Installer.exe: downloads the latest NotchKit-setup.exe from GitHub Releases and runs it.
       .NET Framework 4.8 ships with every Windows 10 and 11, so the exe is a few KB and needs nothing installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NotchKit-Installer</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Lets the .NET SDK build net48 anywhere, including on macOS. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
